# fiverr-expo — copy to .env and fill in values
# Restart Expo after changes (`npx expo start -c` if values don't pick up)

# Message server (HTTP). WebSocket URL is derived from this.
# Local:
# EXPO_PUBLIC_SERVER_URL=http://localhost:8765
# Production:
EXPO_PUBLIC_SERVER_URL=https://fiverr-agent-server.onrender.com

# Gemini (used for AI chat + auto-reply)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash

# Optional aliases (same key/model if you prefer these names)
# EXPO_PUBLIC_AI_API_KEY=
# EXPO_PUBLIC_AI_MODEL=

# Optional OpenAI fallback / legacy
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Optional custom AI endpoints
# EXPO_PUBLIC_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# EXPO_PUBLIC_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Deepgram (voice / translation features)
EXPO_PUBLIC_DEEPGRAM_API_KEY=your_deepgram_api_key_here
